# Employee Desk Booking — configuration
#
# Copy to .env and fill in. Names only live here; values never do.
#
# All of these are read ONCE at startup and validated. The server REFUSES TO START if any
# required value is missing or malformed (US-034/AC-04). That is the designed behaviour, not
# a bug: a service that boots with half a configuration fails later, in production, quietly.

# ---- Supabase -----------------------------------------------------------------
SUPABASE_URL=
# Sent to the browser. Safe to expose; it gets past nothing on its own (RLS is deny-all).
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses every RLS policy in the project. Never bundled into the browser,
# never logged, read in exactly one module (apps/api/src/infra/supabase). See ADR-001.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Office ------------------------------------------------------------------
# IANA name, not an offset. Asia/Kolkata is UTC+05:30 — a half-hour offset that whole-hour
# assumptions get wrong. NO DEFAULT, deliberately (NFR-001): a fallback to UTC would make
# BR-001.14's named failure case — reminders fired at 08:00 UTC while the office is not on
# UTC — the out-of-the-box behaviour. An invalid name fails the startup check, so a typo
# presents as a process that will not boot rather than as times that are quietly wrong.
OFFICE_TIMEZONE=Asia/Kolkata

# ---- Mail (NFR-007, US-034/AC-02, US-034/AC-03) --------------------------------
# Provider still to be chosen — owner: IT. Sender address is TBD until go-live.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM_ADDRESS=

# ---- Web Push (REQ-026) --------------------------------------------------------
# Generate a pair once; the private key is server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- The reminder job (app-architecture.md §4.3) -------------------------------
# POST /api/internal/reminders/run is guarded by this shared secret, not by a user session —
# no user triggers it. Any scheduler may call it; the route is safe to run twice.
REMINDER_RUN_SECRET=

# ---- Server --------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Explicit origins, comma-separated. Never "*" outside local dev.
CORS_ORIGINS=http://localhost:5173

# ---- Session (NFR-009) ---------------------------------------------------------
# Both optional — the defaults below ARE the requirement, identical in every environment.
# An operator may shorten SESSION_LIFETIME_DAYS during an incident; 30 is a ceiling, not a
# suggestion (RISK-010 was accepted for 30 days, not for more). The server refuses to start if
# the throttle is set to meet or exceed the lifetime — sessions would never renew.
# SESSION_LIFETIME_DAYS=30
# SESSION_LAST_SEEN_THROTTLE_MINUTES=60
